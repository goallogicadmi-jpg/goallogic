# URL del backend (Render). Obligatoria en producción (Vercel).
VITE_API_URL=https://goallogic.onrender.com

# Clave publicable Stripe (test o live). En producción usa pk_live_... (Dashboard → Developers → API keys)
# El build de Vite inyecta solo variables que empiezan por VITE_ (en tiempo de build, no en runtime).
# Para `npm run build`: copia este archivo a .env o exporta las mismas variables en CI; sin VITE_STRIPE_PRICE_ID el bundle no llevará precio.
VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXX

# Price ID activo usado en Checkout (misma cuenta que la clave secreta del backend).
# Stripe Dashboard → Catálogo → producto prod_UVmrJCcX6ROUaq → sección Precios → copia el price_… vigente.
# Si cambias el importe del producto, Stripe crea un price nuevo; el anterior queda archivado.
VITE_STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXX
