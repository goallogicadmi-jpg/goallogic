# ============================================
# CONFIGURACIÃ“N DE VARIABLES DE ENTORNO
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renÃ³mbralo a .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas el archivo .env al repositorio
#
# ============================================

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# ============================================
# MONGODB ATLAS
# ============================================
# Cadena de conexiÃ³n a MongoDB Atlas
# Formato: mongodb+srv://usuario:contraseÃ±a@cluster.mongodb.net/nombre_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:contraseÃ±a@cluster.mongodb.net/futbol_analytics?retryWrites=true&w=majority

# ============================================
# API-SPORTS.IO
# ============================================
# API Key de https://api-sports.io
# ObtÃ©n tu API key en: https://dashboard.api-sports.io/
API_KEY=tu_api_key_aqui

# ============================================
# JWT
# ============================================
# En producción: mínimo 32 caracteres aleatorios (el servidor no arranca si es más corto).
# Opcional: duración del token (por defecto 2h). Ej.: JWT_EXPIRES_IN=2h
JWT_SECRET=tu_jwt_secret_largo_y_aleatorio_minimo_32_caracteres
# JWT_EXPIRES_IN=2h

# ============================================
# STRIPE (backend)
# ============================================
# Test: sk_test_... | Producción: sk_live_... (no mezclar en el mismo .env desplegado)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX

# Opcional: mismo price que VITE_STRIPE_PRICE_ID si quieres que create-checkout-session funcione sin priceId en el body.
# Dashboard → prod_UVmrJCcX6ROUaq → Precios → price_… activo.
# STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXX

# Clave publicable: en el frontend usar VITE_STRIPE_PUBLIC_KEY (ver frontend/.env.example). No hace falta en Node para Checkout.

# URLs de retorno tras Checkout (frontend Vite en dev: puerto 5173).
# El servidor añade session_id={CHECKOUT_SESSION_ID} si falta (Stripe lo sustituye; ayuda al caché y al diagnóstico).
# La ruta /success debe existir en el router del frontend (PaymentSuccess → GET /api/auth/me → redirección a /cuenta).
# Desarrollo local (Vite):
# STRIPE_SUCCESS_URL=http://localhost:5173/pago-exitoso
# STRIPE_CANCEL_URL=http://localhost:5173/pago-cancelado
# Producción Render (deben coincidir con rutas en frontend y con Stripe Dashboard → Checkout → Allowed redirect URLs, modo LIVE):
STRIPE_SUCCESS_URL=https://goallogic.vercel.app/pago-exitoso
STRIPE_CANCEL_URL=https://goallogic.vercel.app/pago-cancelado
# STRIPE_PRICE_ID=price_... (mismo modo test/live que STRIPE_SECRET_KEY)

# Webhook (obligatorio en producción). URL en Render: https://goallogic.onrender.com/api/payments/webhook
# En local: Stripe CLI → stripe listen --forward-to localhost:3000/api/payments/webhook
# y copia el "Signing secret" (whsec_...). Sin esto, los eventos reales no verifican la firma.
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX
# Logs muy verbosos (firma + body) en consola; en prod pon STRIPE_WEBHOOK_DEBUG=0
# STRIPE_WEBHOOK_DEBUG=0

# Orígenes extra permitidos por CORS (coma). Incluir URL de Vercel en producción. Ej.: https://tu-app.vercel.app
# CORS_EXTRA_ORIGINS=https://goallogic.vercel.app

# Backups MongoDB (script scripts/mongo-backup-daily.sh): carpeta local y retención en días
# MONGO_BACKUP_DIR=/var/backups/goal-logic/mongo
# MONGO_BACKUP_RETENTION_DAYS=7

# Carpeta del build estático servido por Express (opcional). Ej.: dist si copias el build ahí.
# Por defecto se usa frontend/build (salida de Vite).
# FRONTEND_DIST=dist

# ============================================
# Logs y observabilidad (PASO G)
# ============================================
# Niveles disponibles (de más a menos severo): critical, error, security, webhook, warn, info
# LOG_LEVEL=info
# LOG_HTTP_ACCESS=true

# HSTS en Node (opcional; en producción suele bastar Nginx — ver deploy/nginx-goal-logic.conf)
# ENABLE_HELMET_HSTS=true

# Lista opcional de subcadenas en User-Agent bloqueadas (coma). Ver middleware/optionalBlockedUserAgents.js
# BLOCKED_USER_AGENTS=scrapy,python-requests

# ============================================
# Recuperación de contraseña (SMTP)
# ============================================
# URL del frontend para el enlace del email (sin ?token=)
# PASSWORD_RESET_URL=https://goal-logic.com/reset-password
# Desarrollo:
# PASSWORD_RESET_URL=http://localhost:5173/reset-password

# SMTP (obligatorio en producción para enviar emails)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=noreply@goal-logic.com
# SMTP_PASS=contraseña_smtp
# SMTP_FROM=noreply@goal-logic.com
# SMTP_FROM_NAME=GoalLogic
